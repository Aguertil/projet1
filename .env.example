# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/screenshot_api?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:43210"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Redis (Upstash ou local)
REDIS_URL="redis://localhost:6379"

# Stripe (pour la facturation)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Plans Stripe Price IDs
STRIPE_PRICE_ID_PRO="price_xxx"
STRIPE_PRICE_ID_ENTERPRISE="price_xxx"

# Stockage (S3 compatible)
# Optionnel: utiliser Cloudflare R2, AWS S3, ou stockage local en dev
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="screenshots"
STORAGE_PUBLIC_URL=""

# Configuration de l'application
NEXT_PUBLIC_APP_NAME="ScreenAPI"
NEXT_PUBLIC_APP_URL="http://localhost:43210"

# Limites et quotas
FREE_PLAN_CREDITS=100
PRO_PLAN_CREDITS=5000
ENTERPRISE_PLAN_CREDITS=50000

# Rate limiting (requêtes par minute)
RATE_LIMIT_FREE=10
RATE_LIMIT_PRO=60
RATE_LIMIT_ENTERPRISE=300
